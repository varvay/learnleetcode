---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Approach from '../../components/Approach.astro';
import Explainer from '../../components/Explainer.astro';
import SourceFiles from '../../components/SourceFiles.astro';
import Base from '../../layouts/Base.astro';
import { explainerPath, hasExplainer, type Folder } from '../../lib/folders';

export const getStaticPaths = (async () => {
	const concepts = await getCollection('concepts');
	return concepts.map((concept) => ({ params: { slug: concept.id }, props: { concept } }));
}) satisfies GetStaticPaths;

const { concept } = Astro.props;
const { data } = concept;
const { Content } = await render(concept);
const folder: Folder = `concepts/${concept.id}`;
---

<Base title={data.title}>
	<h1>{data.title}</h1>
	{data.tags.length > 0 && <p>{data.tags.map((tag) => <span class="tag">{tag}</span>)}</p>}
	{data.description && <p class="description">{data.description}</p>}

	<Approach folder={folder} />

	{hasExplainer(folder) && <Explainer file={explainerPath(folder)} />}

	<SourceFiles folder={folder} />

	<Content />
</Base>
