---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const problems = (await getCollection('problems')).sort((a, b) => a.data.id - b.data.id);
---

<Base title="learnleetcode">
	<h1>My LeetCode journey</h1>
	<p class="muted">{problems.length} problem{problems.length === 1 ? '' : 's'} solved.</p>

	<div class="panel">
	<table>
		<thead>
			<tr>
				<th>#</th>
				<th>Title</th>
				<th>Difficulty</th>
				<th>Tags</th>
				<th>Solved</th>
			</tr>
		</thead>
		<tbody>
			{
				problems.map(({ id, data }) => (
					<tr>
						<td>{data.id}</td>
						<td>
							<a href={url(`/problems/${id}/`)}>{data.title}</a>
						</td>
						<td>
							<span class:list={['difficulty', data.difficulty]}>{data.difficulty}</span>
						</td>
						<td>
							{data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</td>
						<td>{data.solved.toISOString().slice(0, 10)}</td>
					</tr>
				))
			}
		</tbody>
	</table>
	</div>
</Base>

<style>
	table {
		width: 100%;
		border-collapse: collapse;
	}
	.panel {
		overflow-x: auto;
	}
	th,
	td {
		text-align: left;
		padding: 10px 14px;
		border-bottom: 1.5px solid var(--rule);
		vertical-align: top;
	}
	th {
		font-size: 0.78rem;
		color: var(--muted);
	}
	tbody tr:last-child td {
		border-bottom: none;
	}
	td:first-child,
	td:last-child {
		color: var(--muted);
		white-space: nowrap;
	}
	@media (max-width: 600px) {
		th:nth-child(4),
		td:nth-child(4) {
			display: none;
		}
	}
</style>
