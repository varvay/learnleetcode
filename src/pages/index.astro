---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const problems = (await getCollection('problems')).sort((a, b) => a.data.id - b.data.id);
const byTitle = <Entry extends { data: { title: string } }>(entries: Entry[]) => entries.sort((a, b) => a.data.title.localeCompare(b.data.title));

const topicSections = [
	{ heading: 'Concepts', blurb: 'Algorithms and techniques that recur across problems.', basePath: 'concepts', entries: byTitle(await getCollection('concepts')) },
	{ heading: 'Utilities', blurb: 'How language and library features behave.', basePath: 'utilities', entries: byTitle(await getCollection('utilities')) },
];
---

<Base title="learnleetcode">
	<h1>My LeetCode journey</h1>
	<p class="muted">{problems.length} problem{problems.length === 1 ? '' : 's'} solved.</p>

	<div class="panel">
	<table>
		<thead>
			<tr>
				<th>#</th>
				<th>Title</th>
				<th>Difficulty</th>
				<th>Tags</th>
				<th>Solved</th>
			</tr>
		</thead>
		<tbody>
			{
				problems.map(({ id, data }) => (
					<tr>
						<td>{data.id}</td>
						<td>
							<a href={url(`/problems/${id}/`)}>{data.title}</a>
						</td>
						<td>
							<span class:list={['difficulty', data.difficulty]}>{data.difficulty}</span>
						</td>
						<td>
							{data.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</td>
						<td>{data.solved.toISOString().slice(0, 10)}</td>
					</tr>
				))
			}
		</tbody>
	</table>
	</div>

	{
		topicSections.map(
			({ heading, blurb, basePath, entries }) =>
				entries.length > 0 && (
					<>
						<h2>{heading}</h2>
						<p class="muted">{blurb}</p>
						<ul class="panel entry-list">
							{entries.map(({ id, data }) => (
								<li>
									<a href={url(`/${basePath}/${id}/`)}>{data.title}</a>
									{data.description && <p class="muted">{data.description}</p>}
									{data.tags.length > 0 && <p>{data.tags.map((tag) => <span class="tag">{tag}</span>)}</p>}
								</li>
							))}
						</ul>
					</>
				),
		)
	}
</Base>

<style>
	table {
		width: 100%;
		border-collapse: collapse;
	}
	.panel {
		overflow-x: auto;
	}
	th,
	td {
		text-align: left;
		padding: 10px 14px;
		border-bottom: 1.5px solid var(--rule);
		vertical-align: top;
	}
	th {
		font-size: 0.78rem;
		color: var(--muted);
	}
	tbody tr:last-child td {
		border-bottom: none;
	}
	td:first-child,
	td:last-child {
		color: var(--muted);
		white-space: nowrap;
	}
	.entry-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.entry-list li {
		padding: 12px 14px;
		border-bottom: 1.5px solid var(--rule);
	}
	.entry-list li:last-child {
		border-bottom: none;
	}
	.entry-list p {
		margin: 4px 0 0;
		font-size: 0.9rem;
	}
	@media (max-width: 600px) {
		th:nth-child(4),
		td:nth-child(4) {
			display: none;
		}
	}
</style>
