---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Approach from '../../components/Approach.astro';
import Explainer from '../../components/Explainer.astro';
import SourceFiles from '../../components/SourceFiles.astro';
import Base from '../../layouts/Base.astro';
import { explainerPath, hasExplainer, type Folder } from '../../lib/folders';

export const getStaticPaths = (async () => {
	const problems = await getCollection('problems');
	return problems.map((problem) => ({ params: { slug: problem.id }, props: { problem } }));
}) satisfies GetStaticPaths;

const { problem } = Astro.props;
const { data } = problem;
const { Content } = await render(problem);
const folder: Folder = `problems/${problem.id}`;
---

<Base title={`${data.id}. ${data.title}`}>
	<h1>{data.id}. {data.title}</h1>
	<p>
		<span class:list={['difficulty', data.difficulty]}>{data.difficulty}</span>
		<span class="muted">&nbsp;· solved {data.solved.toISOString().slice(0, 10)} ·&nbsp;</span><a href={data.link}>Open on LeetCode</a>
	</p>
	{
		data.bookmark !== undefined && (
			<p class="bookmark-callout">
				<strong>Bookmarked</strong> · {data.bookmark}
			</p>
		)
	}
	<p>{data.tags.map((tag) => <span class="tag">{tag}</span>)}</p>
	{
		data.complexity && (
			<p>
				Time <code>{data.complexity.time}</code> · Space <code>{data.complexity.space}</code>
			</p>
		)
	}
	{data.description && <p class="description">{data.description}</p>}

	<Approach folder={folder} />

	{hasExplainer(folder) && <Explainer file={explainerPath(folder)} />}

	<SourceFiles folder={folder} />

	<Content />
</Base>

<style>
	.bookmark-callout {
		background: var(--bookmark-soft);
		border-left: 4px solid var(--bookmark);
		border-radius: 10px;
		padding: 10px 14px;
	}
</style>
