---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Explainer from '../../components/Explainer.astro';
import SourceFiles from '../../components/SourceFiles.astro';
import Base from '../../layouts/Base.astro';
import { hasExplainer, type Folder } from '../../lib/folders';

export const getStaticPaths = (async () => {
	const utilities = await getCollection('utilities');
	return utilities.map((utility) => ({ params: { slug: utility.id }, props: { utility } }));
}) satisfies GetStaticPaths;

const { utility } = Astro.props;
const { data } = utility;
const { Content } = await render(utility);
const folder: Folder = `utilities/${utility.id}`;
---

<Base title={data.title}>
	<h1>{data.title}</h1>
	{data.tags.length > 0 && <p>{data.tags.map((tag) => <span class="tag">{tag}</span>)}</p>}
	{data.description && <p class="description">{data.description}</p>}

	{hasExplainer(folder) && <Explainer folder={folder} />}

	<SourceFiles folder={folder} />

	<Content />
</Base>
